# ─── Database ────────────────────────────────────────────────────────────────
# Option 1: Full connection URL (takes precedence)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Option 2: Individual params (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=michuu_tms

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (in addition to localhost)
CORS_ORIGINS="https://www.michuutms.com,https://admin.michuutms.com"
